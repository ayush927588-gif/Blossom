.service-marquee:hover .marquee-track { animation-play-state: paused; }

@keyframes marquee-slide { 
  100% { transform: translateX(-50%); }
}

.services { background: radial-gradient(at 5% 12%, rgba(255, 210, 191, 0.32), transparent 34%), radial-gradient(at 92% 22%, rgba(220, 205, 242, 0.32), transparent 35%), radial-gradient(at 70% 85%, rgba(190, 230, 224, 0.22), transparent 35%), rgb(255, 253, 251); }

.offer-strip { background: radial-gradient(at 2% 48%, rgba(231, 120, 132, 0.22), transparent 38%), radial-gradient(at 100% 100%, rgba(83, 153, 149, 0.24), transparent 40%), linear-gradient(112deg, rgb(38, 29, 38), rgb(52, 38, 56) 52%, rgb(32, 43, 44)); border-color: rgb(187, 148, 96); box-shadow: rgba(49, 33, 47, 0.19) 0px 17px 40px; }

.offer-highlight:nth-child(2) { background: linear-gradient(145deg, rgba(202, 95, 112, 0.13), transparent); }

.offer-highlight:nth-child(3) { background: linear-gradient(145deg, rgba(145, 105, 177, 0.13), transparent); }

