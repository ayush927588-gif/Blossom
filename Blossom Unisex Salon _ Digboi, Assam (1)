.price-row:hover { background: linear-gradient(90deg, rgba(255, 232, 221, 0.35), rgba(238, 228, 249, 0.28)); padding-right: 5px; }

.why { background: radial-gradient(at 90% 5%, rgba(222, 208, 247, 0.56), transparent 32%), linear-gradient(120deg, rgb(255, 240, 233), rgb(245, 233, 245) 48%, rgb(232, 244, 241)); }

.why-card:nth-child(1) { background: linear-gradient(145deg, rgb(255, 248, 240), rgb(255, 253, 250)); }

