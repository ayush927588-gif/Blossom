.scroll-cue, .hero-side-label { z-index: 3; }

.hero-bloom-ornament { position: absolute; z-index: 2; width: clamp(200px, 28vw, 370px); right: 10%; top: 8%; color: rgba(229, 202, 159, 0.4); opacity: 0.55; pointer-events: none; animation: 7s ease-in-out 0s infinite normal none running ornament-breathe; }

.hero-bloom-ornament svg { width: 100%; height: auto; filter: drop-shadow(rgba(20, 15, 12, 0.18) 0px 12px 25px); }

.hero-petals { position: absolute; z-index: 2; inset: 0px; overflow: hidden; pointer-events: none; }

.hero-petal { position: absolute; top: -8%; width: clamp(12px, 1.5vw, 20px); height: auto; fill: rgba(240, 218, 184, 0.72); stroke: rgba(255, 249, 238, 0.58); stroke-width: 1; filter: drop-shadow(rgba(40, 28, 20, 0.18) 0px 4px 8px); animation: 13s linear 0s infinite normal none running petal-drift; opacity: 0; }

.petal-one { left: 13%; animation-delay: -4s; animation-duration: 15s; }

.petal-two { left: 36%; animation-delay: -10s; animation-duration: 17s; width: 15px; }

.petal-three { left: 59%; animation-delay: -2s; animation-duration: 14s; }

.petal-four { left: 77%; animation-delay: -8s; animation-duration: 18s; width: 13px; }

.petal-five { left: 91%; animation-delay: -5s; animation-duration: 16s; width: 17px; }

