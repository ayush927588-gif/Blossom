@keyframes petal-drift { 
  0% { transform: translate3d(0px, -10vh, 0px) rotate(-25deg); opacity: 0; }
  12% { opacity: 0.65; }
  45% { transform: translate3d(35px, 45vh, 0px) rotate(110deg); }
  88% { opacity: 0.55; }
  100% { transform: translate3d(-28px, 112vh, 0px) rotate(290deg); opacity: 0; }
}

@keyframes ornament-breathe { 
