@charset "utf-8";

:root { --blush: #fbefec; --blush-deep: #f3ddd7; --cream: #fffaf7; --white: #fff; --gold: #b88a50; --gold-light: #d7b786; --ink: #302b29; --muted: #776e69; --line: #eaded8; --serif: 'Playfair Display',Georgia,serif; --sans: 'Poppins',Arial,sans-serif; --shadow: 0 18px 60px rgba(80,52,41,.12); }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; scroll-padding-top: 82px; }

body { margin: 0px; color: var(--ink); background: rgb(255, 255, 255); font-family: var(--sans); font-size: 14px; font-weight: 400; line-height: 1.75; }

img { display: block; max-width: 100%; }

a { color: inherit; text-decoration: none; }

button { font: inherit; }

.skip-link { position: absolute; left: -999px; top: 8px; background: var(--ink); color: rgb(255, 255, 255); padding: 10px 16px; z-index: 100; }

.skip-link:focus { left: 8px; }

.site-header { height: 80px; position: sticky; top: 0px; z-index: 20; background: rgba(255, 250, 247, 0.96); border-bottom: 1px solid rgba(184, 138, 80, 0.13); backdrop-filter: blur(14px); }

.nav-wrap { height: 100%; max-width: 1200px; padding: 0px 28px; margin: auto; display: flex; align-items: center; justify-content: space-between; }

.brand { display: flex; align-items: center; gap: 10px; }

.brand-mark { font-size: 33px; line-height: 1; color: var(--gold); }

.brand-copy { display: flex; flex-direction: column; line-height: 1; }

.brand-copy strong, .footer-brand strong { font: 600 25px var(--serif); letter-spacing: 0.2px; }

.brand-copy small { font-size: 8px; letter-spacing: 1.65px; color: var(--muted); margin-top: 5px; }

.main-nav { display: flex; align-items: center; gap: 32px; font-size: 11px; font-weight: 500; letter-spacing: 0.2px; }

.main-nav > a:not(.nav-book) { transition: color 0.2s; }

.main-nav > a:not(.nav-book):hover { color: var(--gold); }

.nav-book { padding: 11px 17px; border: 1px solid var(--gold); color: rgb(122, 88, 49); transition: 0.2s; }

.nav-book:hover { background: var(--gold); color: white; }

.nav-book span { margin-left: 9px; }

.menu-toggle { display: none; }

.hero { height: min(720px, -80px + 100vh); min-height: 620px; position: relative; overflow: hidden; color: rgb(255, 255, 255); background: url("data:image/jpeg;base64,") center 38% / cover no-repeat rgb(92, 74, 66); }

.hero::before { content: ""; position: absolute; inset: 0px; background: linear-gradient(90deg, rgba(40, 31, 28, 0.77) 0%, rgba(44, 35, 31, 0.54) 47%, rgba(44, 35, 31, 0.08) 100%); }

.hero-shade { position: absolute; inset: 0px; background: linear-gradient(0deg, rgba(41, 30, 25, 0.24), transparent 50%); }

.hero-inner { position: relative; z-index: 1; max-width: 1200px; margin: 0px auto; padding: 112px 28px 80px; }

.eyebrow { display: flex; align-items: center; gap: 10px; margin: 0px 0px 20px; color: var(--gold); font-size: 9px; font-weight: 600; letter-spacing: 2px; line-height: 1.5; }

.eyebrow > span { width: 25px; height: 1px; background: var(--gold); display: inline-block; }

.hero-eyebrow { color: rgb(243, 217, 174); }

.hero h1 { font: 500 clamp(43px,5.2vw,70px)/1.16 var(--serif); letter-spacing: -1.5px; margin: 0px; max-width: 760px; }

.hero h1 em, .welcome h2 em, .section-heading h2 em, .why h2 em, .contact h2 em { color: rgb(228, 196, 152); font-weight: 500; }

.hero-lede { max-width: 490px; color: rgba(255, 255, 255, 0.85); font-size: 13px; line-height: 1.9; margin: 23px 0px 28px; }

.hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

.button { min-height: 48px; display: inline-flex; justify-content: center; align-items: center; gap: 13px; padding: 0px 21px; font-size: 10px; letter-spacing: 0.2px; font-weight: 600; border: 1px solid transparent; transition: transform 0.2s, background 0.2s, color 0.2s; }

.button:hover { transform: translateY(-2px); }

.button-gold { background: var(--gold); color: rgb(255, 255, 255); }

.button-gold:hover { background: rgb(159, 115, 62); }

.button-outline { border-color: rgba(255, 255, 255, 0.7); color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.03); }

.button-outline:hover { background: white; color: var(--ink); }

.hero-note { display: flex; align-items: center; gap: 12px; margin-top: 56px; color: rgba(255, 255, 255, 0.83); font-size: 9px; line-height: 1.7; letter-spacing: 0.5px; }

.hero-note strong { font-size: 10px; color: rgb(255, 255, 255); }

.note-star { font-size: 28px; color: rgb(223, 186, 132); }

.scroll-cue { position: absolute; z-index: 2; bottom: 27px; left: calc(50% - 67px); font-size: 8px; letter-spacing: 1.8px; color: rgba(255, 255, 255, 0.77); display: flex; align-items: center; gap: 10px; }

.scroll-cue span { height: 29px; width: 1px; background: var(--gold-light); }

.hero-side-label { position: absolute; right: 25px; top: 50%; writing-mode: vertical-rl; font-size: 8px; letter-spacing: 3px; color: rgba(255, 255, 255, 0.65); }

.section-pad { padding: 110px max(28px, 50% - 572px); }

.welcome { display: grid; grid-template-columns: 1fr 1fr; gap: 105px; align-items: center; background: var(--cream); }

.welcome-image-wrap { position: relative; max-width: 490px; }

.welcome-image { width: 100%; height: 550px; object-fit: cover; object-position: center center; }

.image-caption { position: absolute; bottom: 0px; left: 0px; right: 0px; height: 52px; background: rgba(49, 39, 34, 0.86); color: white; display: flex; align-items: center; justify-content: space-between; padding: 0px 20px; font-size: 9px; letter-spacing: 0.6px; }

.image-caption span:first-child { color: rgb(231, 190, 129); font: 500 17px var(--serif); }

.gold-stamp { position: absolute; right: -33px; top: 43px; width: 106px; height: 106px; border-radius: 50%; background: var(--gold); color: rgb(255, 255, 255); display: flex; flex-direction: column; align-items: center; justify-content: center; transform: rotate(9deg); box-shadow: rgba(152, 116, 71, 0.22) 0px 7px 22px; }

.gold-stamp span { font-size: 8px; text-align: center; letter-spacing: 1.2px; line-height: 1.4; }

.gold-stamp b { font-size: 16px; margin-top: 2px; }

.welcome-copy { padding: 15px 0px; }

.welcome h2, .section-heading h2, .why h2, .contact h2 { font: 500 clamp(40px,4.5vw,54px)/1.15 var(--serif); letter-spacing: -0.8px; margin: 0px 0px 24px; }

.welcome h2 em, .section-heading h2 em, .why h2 em { color: var(--gold); font-style: italic; }

.body-copy { max-width: 505px; color: var(--muted); font-size: 12px; line-height: 2.05; margin: 0px 0px 15px; }

.welcome-points { display: grid; gap: 11px; margin: 25px 0px; font-size: 11px; font-weight: 500; }

.check { margin-right: 10px; display: inline-flex; align-items: center; justify-content: center; width: 17px; height: 17px; border-radius: 50%; background: rgb(239, 226, 209); color: rgb(144, 108, 64); font-size: 10px; }

.text-link { display: inline-flex; align-items: center; gap: 14px; color: rgb(138, 101, 55); border-bottom: 1px solid rgb(217, 193, 160); padding-bottom: 5px; font-size: 10px; font-weight: 600; }

.text-link span { font-size: 15px; }

.services { background: rgb(255, 255, 255); padding-top: 100px; padding-bottom: 100px; }

.section-heading { text-align: center; margin: 0px auto 47px; }

.section-heading .eyebrow { justify-content: center; }

.section-heading h2 { font-size: 46px; margin-bottom: 12px; }

.section-heading > p:last-child { font-size: 12px; color: var(--muted); margin: 0px; }

.service-panel { max-width: 1000px; margin: auto; display: grid; grid-template-columns: 295px 1fr; min-height: 454px; background: var(--cream); box-shadow: var(--shadow); }

.service-tabs { background: var(--blush); padding: 24px 0px; }

.service-tab { display: flex; width: 100%; align-items: center; text-align: left; gap: 14px; border: 0px; background: transparent; padding: 17px 24px; color: rgb(102, 92, 87); font-weight: 500; font-size: 10px; cursor: pointer; position: relative; transition: 0.2s; }

.service-tab > span { font: 500 14px var(--serif); color: rgb(184, 168, 155); }

.service-tab.active { color: var(--ink); background: rgba(255, 255, 255, 0.73); }

.service-tab.active::before { content: ""; position: absolute; left: 0px; top: 0px; bottom: 0px; width: 3px; background: var(--gold); }

.service-tab.active > span { color: var(--gold); }

.service-tab:hover:not(.active) { color: rgb(141, 103, 64); background: rgba(255, 255, 255, 0.38); }

.service-content { padding: 42px 54px; }

.service-content-heading { display: flex; align-items: center; gap: 18px; }

.service-flower { width: 48px; height: 48px; border: 1px solid rgb(229, 211, 189); color: var(--gold); display: grid; place-items: center; font-size: 26px; border-radius: 50%; }

.service-content-heading .eyebrow { font-size: 8px; margin-bottom: 5px; }

.service-content h3 { font: 500 29px/1.3 var(--serif); margin: 0px; }

.service-intro { color: var(--muted); font-size: 11px; margin: 17px 0px 14px; }

.price-list { display: grid; grid-template-columns: 1fr 1fr; column-gap: 26px; }

.price-row { display: flex; justify-content: space-between; gap: 8px; border-bottom: 1px solid rgb(238, 227, 221); padding: 9px 0px; font-size: 10px; line-height: 1.5; }

.price-row strong { white-space: nowrap; color: rgb(145, 107, 62); font-weight: 600; }

.price-note { font-size: 9px; color: rgb(147, 137, 131); margin: 13px 0px 19px; }

.button-dark { min-height: 42px; background: var(--ink); color: white; font-size: 9px; }

.button-dark:hover { background: rgb(80, 65, 58); }

.service-footnote { text-align: center; color: var(--muted); font-size: 10px; margin: 25px 0px 0px; }

.why { background: var(--blush); padding-top: 100px; padding-bottom: 100px; }

.why-top { display: flex; justify-content: space-between; gap: 50px; align-items: end; margin: 0px auto 47px; max-width: 1000px; }

.why-top .eyebrow { margin-bottom: 14px; }

