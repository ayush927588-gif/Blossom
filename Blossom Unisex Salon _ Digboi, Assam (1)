.offer-strip-label strong { color: rgb(255, 245, 233); }

.service-tabs { background: linear-gradient(rgb(255, 244, 237), rgb(244, 238, 249) 53%, rgb(237, 247, 245)); }

.service-tab { border-bottom: 1px solid rgba(101, 75, 104, 0.06); }

