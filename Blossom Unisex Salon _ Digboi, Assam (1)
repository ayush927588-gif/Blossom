.service-tab:hover:not(.active) { background: linear-gradient(90deg, rgba(235, 211, 232, 0.38), rgba(255, 239, 221, 0.5)); color: rgb(104, 71, 114); }

.service-content { transition: background 0.35s; }

.service-content[data-category="hair"] { background: radial-gradient(at 100% 0px, rgba(255, 220, 194, 0.3), transparent 38%), linear-gradient(145deg, rgb(255, 253, 250), rgb(255, 250, 247) 68%, rgb(255, 243, 233)); }

