.button-gold { background: linear-gradient(115deg, rgb(130, 97, 59), rgb(181, 149, 97) 48%, rgb(129, 96, 58)) 0px 0px / 200% 100%; }

.button-gold:hover { background-position: 100% 0px; }

.button-gold::after { content: ""; position: absolute; top: -100%; bottom: -100%; left: -40%; width: 25%; transform: rotate(22deg); background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.34), transparent); transition: left 0.65s; }

.button-gold:hover::after { left: 125%; }

.button-outline, .button-light, .button-dark { border-radius: 2px; }

.section-pad { position: relative; }

.welcome { background: linear-gradient(120deg, rgb(255, 250, 247) 0%, rgb(255, 249, 245) 65%, rgb(247, 236, 230) 100%); }

.welcome-image-wrap { padding: 10px; border: 1px solid rgba(155, 120, 70, 0.52); border-radius: 240px 240px 5px 5px; background: linear-gradient(135deg, rgb(255, 253, 249), rgb(241, 227, 213)); box-shadow: rgba(57, 42, 31, 0.12) 0px 22px 55px; overflow: visible; }

.welcome-image { height: 530px; border-radius: 220px 220px 2px 2px; filter: saturate(0.86) contrast(1.02); }

.welcome-image-wrap::after { content: ""; position: absolute; inset: 5px; border: 1px solid rgba(255, 255, 255, 0.62); border-radius: 236px 236px 2px 2px; pointer-events: none; }

.image-caption { left: 10px; right: 10px; bottom: 10px; z-index: 1; border-radius: 0px 0px 2px 2px; background: linear-gradient(90deg, rgba(38, 30, 25, 0.87), rgba(38, 30, 25, 0.55)); backdrop-filter: blur(8px); }

.gold-stamp { right: -29px; top: 55px; border: 1px solid rgba(255, 246, 229, 0.8); outline: rgba(155, 120, 70, 0.65) solid 1px; outline-offset: 5px; background: linear-gradient(145deg, rgb(169, 137, 86), rgb(121, 90, 53)); box-shadow: rgba(56, 40, 25, 0.22) 0px 12px 30px; }

.ornamental-divider { display: flex; align-items: center; gap: 10px; width: 146px; margin: 10px auto 18px; color: rgb(168, 136, 87); }

.ornamental-divider span { height: 1px; flex: 1 1 0%; background: linear-gradient(90deg, transparent, currentcolor); }

.ornamental-divider span:last-child { transform: rotate(180deg); }

.ornamental-divider svg { width: 19px; height: 19px; flex: 0 0 auto; fill: currentcolor; }

.welcome-copy > .ornamental-divider, .why-top .ornamental-divider, .contact-intro > .ornamental-divider { margin-left: 0px; margin-right: 0px; }

.section-heading h2, .welcome h2, .why h2, .contact h2 { letter-spacing: -1.1px; }

.section-heading .eyebrow { letter-spacing: 2.2px; }

.services { background: radial-gradient(at 50% 40%, rgb(255, 255, 255) 0px, rgb(255, 255, 255) 44%, rgb(251, 244, 239) 100%); }

.service-panel { border: 1px solid rgba(155, 120, 70, 0.24); border-radius: 3px; overflow: hidden; box-shadow: rgba(63, 44, 32, 0.1) 0px 20px 58px; }

.service-tabs { background: linear-gradient(rgb(249, 239, 234), rgb(245, 233, 227)); }

.service-tab { transition: background 0.25s, color 0.25s, padding 0.25s; }

.service-tab:hover:not(.active) { padding-left: 29px; }

.service-content { background: linear-gradient(145deg, rgb(255, 253, 250) 0%, rgb(255, 250, 247) 72%, rgb(251, 242, 235) 100%); }

.service-flower { background: linear-gradient(145deg, rgb(255, 255, 255), rgb(247, 236, 221)); box-shadow: rgba(255, 255, 255, 0.7) 0px 0px 0px 4px inset, rgba(74, 52, 30, 0.05) 0px 5px 15px; }

.price-row { transition: padding 0.2s, border-color 0.2s; }

.price-row:hover { padding-left: 5px; border-color: rgba(155, 120, 70, 0.52); }

.offer-strip { position: relative; isolation: isolate; overflow: hidden; border: 1px solid rgb(169, 133, 80); border-radius: 3px; background: radial-gradient(at 5% 50%, rgba(183, 146, 91, 0.2), transparent 38%), linear-gradient(115deg, rgb(37, 31, 26) 0%, rgb(54, 42, 32) 52%, rgb(36, 30, 25) 100%); box-shadow: rgba(50, 34, 22, 0.17) 0px 14px 32px; }

.offer-strip::after { content: ""; position: absolute; z-index: -1; inset: 7px; border: 1px solid rgba(219, 190, 137, 0.28); pointer-events: none; }

.offer-strip-label, .offer-highlight { position: relative; z-index: 1; }

.offer-strip-label { background: transparent; }

.offer-strip-label strong { color: rgb(242, 230, 210); letter-spacing: 0.2px; }

.offer-bloom { width: 38px; height: 38px; display: grid; place-items: center; color: rgb(200, 165, 109); }

.offer-bloom svg { width: 100%; height: 100%; fill: none; stroke: currentcolor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }

.offer-bloom .diya-flame { fill: currentcolor; stroke: none; }

.offer-highlight { border-left-color: rgba(205, 174, 120, 0.33); }

.offer-highlight > span { color: rgb(225, 193, 142); }

.offer-highlight strong { color: rgb(255, 248, 237); }

.offer-highlight small { color: rgb(213, 199, 182); }

.offer-highlight:nth-child(2) > span, .offer-highlight:nth-child(3) > span, .offer-highlight:nth-child(4) > span { color: rgb(225, 193, 142); }

.offer-highlight:hover { background: rgba(223, 191, 138, 0.06); }

.why { background: radial-gradient(at 82% 10%, rgba(255, 255, 255, 0.7), transparent 35%), linear-gradient(135deg, rgb(249, 236, 232), rgb(244, 227, 220)); }

.why-card { position: relative; border: 1px solid rgba(155, 120, 70, 0.17); border-radius: 3px; background: linear-gradient(150deg, rgba(255, 255, 255, 0.91), rgba(255, 253, 250, 0.77)); box-shadow: rgba(55, 38, 26, 0.035) 0px 8px 25px; overflow: hidden; }

.why-card::before { content: ""; position: absolute; left: 0px; right: 0px; top: 0px; height: 2px; background: linear-gradient(90deg, transparent, rgb(181, 151, 102), transparent); opacity: 0.65; transition: opacity 0.25s; }

.why-card:hover { transform: translateY(-6px); border-color: rgba(155, 120, 70, 0.42); box-shadow: rgba(55, 38, 26, 0.12) 0px 18px 38px; }

.why-card:hover::before { opacity: 1; }

.why-icon { border: 1px solid rgba(155, 120, 70, 0.18); background: linear-gradient(145deg, rgb(255, 253, 248), rgb(241, 225, 214)); }

.gallery { background: linear-gradient(rgb(255, 250, 247), rgb(251, 243, 238)); }

.gallery-item { border: 1px solid rgba(167, 132, 79, 0.38); border-radius: 14px; box-shadow: rgba(48, 33, 23, 0.12) 0px 12px 30px; isolation: isolate; }

.gallery-item.gallery-tall { border-radius: 170px 170px 5px 5px; }

.gallery-item:nth-child(2), .gallery-item:nth-child(4) { border-radius: 4px 30px; }

.gallery-item:nth-child(3), .gallery-item:nth-child(5) { border-radius: 30px 4px; }

.gallery-item img { filter: saturate(0.82) contrast(1.02); transition: transform 0.7s cubic-bezier(0.2, 0.75, 0.2, 1), filter 0.45s; }

.gallery-item:hover img { transform: scale(1.06); filter: saturate(1.04) contrast(1.03) brightness(0.82); }

.gallery-item::before { content: ""; position: absolute; z-index: 2; inset: 8px; border: 1px solid rgba(244, 221, 182, 0.74); border-radius: inherit; pointer-events: none; opacity: 0.75; transition: inset 0.3s, opacity 0.3s; }

.gallery-item:hover::before { inset: 13px; opacity: 1; }

.gallery-item::after { z-index: 1; inset: 35% 0px 0px; background: linear-gradient(transparent, rgba(28, 22, 19, 0.68)); }

.gallery-item > span { z-index: 3; text-shadow: rgba(0, 0, 0, 0.65) 0px 2px 8px; }

.testimonial { background: radial-gradient(at 50% 0%, rgb(255, 250, 245), rgb(247, 233, 226) 72%); border-top: 1px solid rgba(170, 133, 78, 0.12); border-bottom: 1px solid rgba(170, 133, 78, 0.12); }

.testimonial-ornament { color: rgba(155, 120, 70, 0.13); }

.review-slider { padding: 26px 35px; border: 1px solid rgba(155, 120, 70, 0.18); border-radius: 3px; background: rgba(255, 253, 250, 0.5); box-shadow: rgba(60, 42, 30, 0.043) 0px 12px 35px; backdrop-filter: blur(6px); }

.review-slider blockquote { font-size: 20px; }

.slider-arrow { transition: transform 0.2s, background 0.2s, color 0.2s, box-shadow 0.2s; }

.slider-arrow:hover { transform: scale(1.08); box-shadow: rgba(82, 58, 34, 0.16) 0px 4px 12px; }

.contact { background: radial-gradient(at 90% 2%, rgba(163, 127, 77, 0.22), transparent 32%), linear-gradient(120deg, rgb(33, 29, 26), rgb(52, 42, 35) 55%, rgb(33, 30, 27)); border-top: 1px solid rgba(221, 186, 124, 0.22); }

.contact-card { border: 1px solid rgba(202, 170, 112, 0.45); border-radius: 3px; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.25) 0px 22px 62px; }

.map-wrap { overflow: hidden; }

.site-footer { border-top: 1px solid rgba(219, 193, 143, 0.22); }

.floating-whatsapp { transition: transform 0.25s, box-shadow 0.25s; }

.floating-whatsapp:hover { transform: translateY(-4px) scale(1.06); box-shadow: rgba(35, 104, 66, 0.4) 0px 10px 28px; }

.reveal-on-scroll { opacity: 0; transform: translateY(24px); transition: opacity 0.7s, transform 0.75s cubic-bezier(0.2, 0.7, 0.25, 1); }

.reveal-on-scroll.is-visible { opacity: 1; transform: translateY(0px); }

.why-card.reveal-on-scroll:nth-child(2), .gallery-item.reveal-on-scroll:nth-child(2) { transition-delay: 0.08s; }

.why-card.reveal-on-scroll:nth-child(3), .gallery-item.reveal-on-scroll:nth-child(3) { transition-delay: 0.15s; }

.why-card.reveal-on-scroll:nth-child(4), .gallery-item.reveal-on-scroll:nth-child(4) { transition-delay: 0.22s; }

.why-card.reveal-on-scroll:nth-child(5), .gallery-item.reveal-on-scroll:nth-child(5) { transition-delay: 0.29s; }

@media (max-width: 900px) {
  .hero-bloom-ornament { right: 4%; top: 10%; width: clamp(190px, 32vw, 280px); }
  .welcome-image { height: 510px; }
  .why-grid { gap: 12px; }
}

@media (max-width: 680px) {
  .site-header { background: rgba(255, 250, 247, 0.87); box-shadow: rgba(50, 35, 25, 0.05) 0px 4px 20px; }
  .hero { background-image: none; }
  .hero-scenery { background-position: 57% center; }
  .hero-bloom-ornament { right: -42px; top: -1%; width: 170px; opacity: 0.2; }
  .hero-petal { width: 14px; }
  .hero-inner { padding-top: 112px; }
  .welcome-image-wrap { border-radius: 190px 190px 5px 5px; }
  .welcome-image { height: 410px; border-radius: 180px 180px 2px 2px; }
  .welcome-image-wrap::after { border-radius: 186px 186px 2px 2px; }
  .gold-stamp { right: -15px; top: 45px; }
  .ornamental-divider { width: 126px; margin: 8px auto 15px; }
  .welcome-copy > .ornamental-divider, .why-top .ornamental-divider, .contact-intro > .ornamental-divider { margin-left: 0px; }
  .service-panel { border-radius: 3px; }
  .offer-strip { border-radius: 3px; }
  .offer-strip::after { inset: 5px; }
  .offer-strip-label { min-height: 68px; }
  .offer-bloom { width: 31px; height: 31px; }
  .offer-highlight { min-height: 80px; }
  .gallery-item.gallery-tall { border-radius: 125px 125px 5px 5px; }
  .gallery-item::before { inset: 6px; }
  .review-slider { padding: 22px 17px; }
  .review-slider blockquote { font-size: 17px; }
  .why-card { border-radius: 3px; }
  .contact-card { border-radius: 3px; }
  .reveal-on-scroll { transform: translateY(16px); transition-duration: 0.55s; }
}

@media (prefers-reduced-motion: reduce) {
  .hero-petal, .hero-bloom-ornament { animation: auto ease 0s 1 normal none running none !important; }
  .hero-scenery { transform: none !important; will-change: auto; }
  .reveal-on-scroll { opacity: 1; transform: none; transition: none; }
  .button-gold::after { display: none; }
  .gallery-item img, .why-card, .button, .slider-arrow { transition: none; }
}

:root { --coral: #9d443b; --berry: #9f4767; --plum: #695080; --teal: #22676a; --peach: #a75c43; --lavender: #f0eafa; --blush: #fbefec; }

.hero-shade { background: linear-gradient(0deg, rgba(41, 30, 25, 0.32), transparent 56%) 0% 0% / 100% 100%, linear-gradient(115deg, rgba(172, 62, 91, 0.32), rgba(119, 79, 142, 0.23), rgba(27, 114, 120, 0.22), rgba(205, 112, 69, 0.2)) 0% 0% / 300% 300%; background-blend-mode: normal, soft-light; animation: 22s ease-in-out 0s infinite normal none running chromatic-drift; }

.hero-bloom-ornament { color: rgba(242, 184, 172, 0.5); }

.hero-petal { fill: rgba(255, 219, 204, 0.78); stroke: rgba(253, 233, 221, 0.7); }

.hero-sparkle { position: absolute; color: rgb(248, 217, 155); font-size: 14px; text-shadow: rgba(253, 219, 157, 0.72) 0px 0px 13px; animation: 3.8s ease-in-out 0s infinite normal none running sparkle-pulse; }

.sparkle-one { left: 25%; top: 27%; animation-delay: -1.2s; }

.sparkle-two { left: 71%; top: 58%; font-size: 11px; animation-delay: -2.4s; }

.sparkle-three { left: 86%; top: 23%; font-size: 9px; animation-delay: -0.5s; }

@keyframes chromatic-drift { 
  0%, 100% { background-position: 0px 0px, 0% 40%; }
  50% { background-position: 0px 0px, 100% 60%; }
}

@keyframes sparkle-pulse { 
  0%, 100% { opacity: 0.24; transform: scale(0.76) rotate(0deg); }
  50% { opacity: 0.95; transform: scale(1.12) rotate(24deg); }
}

.button-gold { background-image: linear-gradient(112deg, rgb(159, 71, 103) 0%, rgb(157, 68, 59) 34%, rgb(105, 80, 128) 67%, rgb(34, 103, 106) 100%); background-size: 220% 100%; background-position: 0% 50%; box-shadow: rgba(97, 53, 77, 0.22) 0px 8px 22px; }

.button-gold:hover { background-position: 100% 50%; box-shadow: rgba(83, 53, 94, 0.28) 0px 12px 30px; }

.button-gold::after { background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.48), transparent); }

.button-outline { border-color: rgba(255, 255, 255, 0.82); box-shadow: rgba(255, 255, 255, 0.08) 0px 0px 0px 1px inset; }

.button-dark { background: linear-gradient(110deg, rgb(73, 50, 79), rgb(54, 95, 99)); transition: transform 0.25s, box-shadow 0.25s, background-position 0.45s; }

.button-dark:hover { background: linear-gradient(110deg, rgb(109, 61, 98), rgb(40, 117, 121)); transform: translateY(-3px); box-shadow: rgba(62, 41, 76, 0.2) 0px 10px 23px; }

.ornamental-divider { color: rgb(173, 100, 131); }

.ornamental-divider span { background: linear-gradient(90deg, transparent, rgb(199, 125, 123), rgb(155, 130, 187)); }

.ornamental-divider span:last-child { background: linear-gradient(90deg, transparent, rgb(155, 130, 187), rgb(199, 125, 123)); }

.welcome { background: linear-gradient(120deg, rgb(255, 250, 247) 0%, rgb(255, 245, 239) 42%, rgb(246, 238, 249) 76%, rgb(238, 247, 245) 100%); }

.welcome-image-wrap { border-color: rgba(181, 103, 117, 0.45); background: linear-gradient(135deg, rgb(255, 253, 249), rgb(247, 231, 226) 45%, rgb(238, 232, 247) 100%); }

.gold-stamp { background: linear-gradient(145deg, rgb(185, 103, 116), rgb(124, 88, 126) 55%, rgb(56, 116, 119)); }

.check { background: linear-gradient(135deg, rgb(251, 227, 215), rgb(238, 229, 247)); color: rgb(117, 81, 125); }

.text-link { color: rgb(113, 77, 119); border-color: rgb(201, 141, 130); transition: color 0.2s, gap 0.2s; }

.text-link:hover { color: rgb(36, 113, 118); gap: 18px; }

.stat-band { padding: 28px 24px; background: linear-gradient(108deg, rgb(113, 55, 85) 0%, rgb(98, 75, 120) 35%, rgb(34, 93, 101) 68%, rgb(143, 71, 64) 100%); color: white; }

.stat-inner { max-width: 1000px; margin: auto; display: grid; grid-template-columns: repeat(4, 1fr); }

.stat-item { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; min-height: 80px; border-right: 1px solid rgba(255, 255, 255, 0.24); text-align: center; }

.stat-item:last-child { border-right: 0px; }

.stat-item strong { font: 500 32px/1.1 var(--serif); color: rgb(255, 224, 177); letter-spacing: -0.8px; }

.stat-item > span { font-size: 9px; letter-spacing: 0.8px; color: rgba(255, 255, 255, 0.88); }

.service-marquee { overflow: hidden; position: relative; padding: 12px 0px; background: linear-gradient(90deg, rgb(255, 240, 232), rgb(241, 234, 250) 48%, rgb(229, 244, 241)); border-top: 1px solid rgba(177, 98, 117, 0.16); border-bottom: 1px solid rgba(55, 119, 119, 0.16); }

