.button { position: relative; overflow: hidden; box-shadow: rgba(30, 23, 18, 0.12) 0px 5px 18px; transition: transform 0.28s cubic-bezier(0.2, 0.75, 0.25, 1), box-shadow 0.28s, background 0.25s, color 0.25s; }

